# Database URL - Replace with your actual database connection string
# For local development with PostgreSQL:
# POSTGRES_PRISMA_URL="postgresql://username:password@localhost:5432/fired_chicken_db"

# For cloud databases (e.g., Supabase, Neon, PlanetScale):
POSTGRES_PRISMA_URL="your-database-connection-string-here"


# Platform Fee Rates (percentage, 0-100)
# These are the commission rates charged by delivery platforms
GRAB_FOOD_FEE_RATE=30
LINE_MAN_FEE_RATE=30

# Application Environment
NODE_ENV=development

# NextAuth.js Configuration (required for authentication)
# Generate secret with: openssl rand -base64 32
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="your-secret-key-generate-with-openssl-rand-base64-32"

# Optional: Application version (populated by CI/CD)
# APP_VERSION=1.0.0
